# cc-probeline configuration template.
#
# Location options (in precedence order):
#   1. CC_PROBELINE_CONFIG=/absolute/path/config.toml  (env override)
#   2. .cc-probeline.toml in current repo               (project-local)
#   3. ~/.config/cc-probeline/config.toml               (global, this template)
#
# To customize, copy this file to ~/.config/cc-probeline/config.toml and edit.
# All fields are optional — missing fields use the built-in defaults.
# Run `cc-probeline check-config` to validate.

version = 1

[general]
# Rotating tutorial hints in the status line (`cc-probeline hints on|off` toggles this).
# Default: true
tutorial_hints = true

# Force NO_COLOR semantics even when NO_COLOR env is unset.
# ENV NO_COLOR=1 takes precedence over this.
# Default: false
no_color = false

# Enable Nerd Font icons. Default: false (auto-detection lands in Phase 7).
nerd_font = false

# Documentation hint for next `cc-probeline install` (does NOT re-run installer).
# Default: 5 (seconds)
refresh_interval_hint = 5

# Maximum number of per-turn rows in the cost table. Capped at 40.
# 0 is valid and means "no per-turn table at all" — rows, legend and frame go.
# Default: 10
table_rows = 10

# ─── Vertical footprint ──────────────────────────────────────────────────────
# Each key below removes whole terminal rows from the status line, and they
# stack. All default to true, so an existing config keeps the original layout.

# Legend row under the table ("# role model cache r/w out ~cost tool") plus the
# ├─┼─┤ separator above it. Worth 2 rows.
# Default: true
table_legend = true

# Table frame: the ┌─┬─┐ / └─┴─┘ border lines and the outer bar on every row.
# Worth 2 more rows; the columns stay aligned without it.
# Default: true
table_frame = true

# Inner vertical column separators (│) and the group-boundary notches (├ ┼ ┤)
# that mark where one orchestrator request ends. Costs no rows — set false only
# to quieten the table visually.
# Default: true
table_dividers = true

# First header line: email • project • quota bars.
# Default: true
header_line0 = true

# Second header line: model • ctx • cost • time • git.
# Default: true
header_line1 = true

[widgets]
# Per-widget on/off toggles. All true by default.
model    = true
effort   = true
cost     = true
project  = true
email    = true
time     = true
ctx      = true
quota    = true
git      = true

# Per-model weekly rate-limit windows, shown next to the account-wide bars as
# "Fable 7d: ▒░░░░░░░░░ ↻ 6d.8h". These windows are not part of the status-line
# payload, so the figures come from the usage snapshot Claude Code caches in
# ~/.claude.json (read-only, offline — no credentials, no network). Renders
# nothing when the account has no model-scoped limit.
quota_model = true

[thresholds]
# Session cost warning threshold ($). 0 disables.
cost_budget_usd     = 0

# Context window fill ratios for the three colour flips (yellow/orange/red).
# Must strictly increase: notice < warn < critical. Invalid values fall back to
# these defaults (the status line never breaks on a bad config).
ctx_notice_ratio    = 0.50
ctx_warn_ratio      = 0.70
ctx_critical_ratio  = 0.90

# Rate-limit usage colour flips (yellow/orange/red), per window. Same rules as
# ctx: must strictly increase notice < warn < critical; invalid → these defaults.
quota_5h_notice_ratio   = 0.50
quota_5h_warn_ratio     = 0.70
quota_5h_critical_ratio = 0.90
quota_7d_notice_ratio   = 0.50
quota_7d_warn_ratio     = 0.70
quota_7d_critical_ratio = 0.90

# Cache alert thresholds.
orch_ttl_minutes      = 60
subagent_gap_minutes  = 5

[probes.email]
# Override email address (default: auto-detected from ~/.claude.json, then git config user.email).
address = ""
